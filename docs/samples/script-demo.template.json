{
  "schemaVersion": "0.1",
  "paper": { "preset": "A4", "widthMm": 210, "heightMm": 297, "orientation": "Portrait" },
  "margins": { "top": 10, "right": 10, "bottom": 10, "left": 10 },
  "elements": [
    {
      "id": "el-title", "type": "text", "xMm": 14, "yMm": 14, "widthMm": 120, "heightMm": 14, "zIndex": 0,
      "testData": "VIP大客户订单",
      "text": {
        "content": "{{title}}", "fontFamily": "Microsoft YaHei", "fontSizePt": 18,
        "bold": true, "color": "#1F3864", "horizontalAlign": "Left", "verticalAlign": "Middle", "wrap": false, "lineSpacing": 1.2
      },
      "formatter": "function(value){ return value ? ('【' + value + '】发货单') : '发货单'; }",
      "styler": "function(value){ return value && value.indexOf('VIP') >= 0 ? { color: '#B8860B', bold: true, fontSizePt: 22 } : { color: '#1F3864', bold: true, fontSizePt: 18 }; }"
    },
    {
      "id": "el-order", "type": "text", "xMm": 14, "yMm": 31, "widthMm": 120, "heightMm": 8, "zIndex": 0,
      "testData": "ORD-20261030-0001",
      "text": {
        "content": "订单号：{{orderNo}}", "fontFamily": "Consolas", "fontSizePt": 10,
        "color": "#555555", "horizontalAlign": "Left", "verticalAlign": "Middle", "wrap": false, "lineSpacing": 1.2
      },
      "formatter": "function(value){ return value ? ('NO-' + value) : ''; }"
    },
    {
      "id": "el-vipbox", "type": "rectangle", "xMm": 148, "yMm": 14, "widthMm": 48, "heightMm": 22, "zIndex": 0,
      "backgroundColor": null, "borderColor": "#D4A017", "borderWidthMm": 0.4, "borderDashPatternMm": null, "opacity": 1,
      "rectangle": { "strokeColor": null, "strokeWidthMm": 0.2, "fillColor": null, "cornerRadiusMm": 3, "dashPatternMm": null },
      "styler": "function(){ return { borderColor: '#D4A017', borderWidth: '0.8mm', backgroundColor: '#FFF8E1' }; }"
    },
    {
      "id": "el-viptext", "type": "text", "xMm": 152, "yMm": 21, "widthMm": 40, "heightMm": 8, "zIndex": 1,
      "text": {
        "content": "VIP 专属通道", "fontFamily": "Microsoft YaHei", "fontSizePt": 11,
        "bold": true, "color": "#B8860B", "horizontalAlign": "Center", "verticalAlign": "Middle", "wrap": false, "lineSpacing": 1.2
      },
      "styler": "function(){ return { color: '#B8860B', bold: true, letterSpacingPt: 1.5 }; }"
    },
    {
      "id": "el-rule", "type": "line", "xMm": 14, "yMm": 44, "widthMm": 182, "heightMm": 0, "zIndex": 1,
      "line": { "strokeColor": "#8899AA", "strokeWidthMm": 0.3, "direction": "Horizontal", "dashPatternMm": null },
      "styler": "function(){ return { borderColor: '#D4A017', borderWidth: '0.6mm' }; }"
    },
    {
      "id": "el-qr", "type": "qrcode", "xMm": 14, "yMm": 52, "widthMm": 28, "heightMm": 28, "zIndex": 2,
      "qrcode": {
        "content": "{{orderNo}}", "errorCorrection": "Q",
        "foregroundColor": "#000000", "backgroundColor": "#FFFFFF", "quietZoneMm": 1.5
      },
      "formatter": "function(value, options, target, templateData){ return 'https://crossprint.demo/track/' + (value || ''); }",
      "styler": "function(){ return { color: '#1F3864' }; }"
    },
    {
      "id": "el-bar", "type": "barcode", "xMm": 50, "yMm": 58, "widthMm": 100, "heightMm": 16, "zIndex": 2,
      "testData": "sku-88-a",
      "barcode": {
        "content": "{{sku}}", "symbology": "Code128",
        "barColor": "#000000", "backgroundColor": null,
        "showText": true, "fontSizePt": 7, "fontFamily": "Consolas"
      },
      "formatter": "function(value){ return (value || '').replace(/\\s+/g, '').toUpperCase(); }"
    },
    {
      "id": "el-table", "type": "table", "xMm": 14, "yMm": 92, "widthMm": 182, "heightMm": 70, "zIndex": 3,
      "testData": "龙井茶礼盒\t2\t298.00\t596.00\tPAID\n金骏眉红茶\t1\t3200.00\t3200.00\tUNPAID\n白瓷盖碗\t3\t128.00\t384.00\tPAID\n竹制茶盘\t1\t899.00\t899.00\tSHIPPED\n公道杯配件\t5\t45.00\t225.00\tPAID",
      "table": {
        "columns": [
          {
            "title": "品名", "widthMm": 82, "field": "items.name", "align": "Left", "fontSizePt": null,
            "formatter": "function(value, row, index){ return (index + 1) + '. ' + value; }"
          },
          {
            "title": "数量", "widthMm": 22, "field": "items.qty", "align": "Right", "fontSizePt": null,
            "formatter": "function(value){ return 'x' + value; }"
          },
          {
            "title": "单价", "widthMm": 26, "field": "items.price", "align": "Right", "fontSizePt": null,
            "formatter": "function(value){ return '¥' + Number(value).toFixed(2); }"
          },
          {
            "title": "金额", "widthMm": 26, "field": "items.amount", "align": "Right", "fontSizePt": null,
            "formatter": "function(value){ return '¥' + Number(value).toFixed(2).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ','); }",
            "styler": "function(value, row){ return Number(value) >= 2000 ? { color: '#C00000', bold: true } : null; }",
            "summary": "Sum", "summaryLabel": "合计："
          },
          {
            "title": "状态", "widthMm": 26, "field": "items.status", "align": "Center", "fontSizePt": null,
            "formatter": "function(value){ return ({ PAID: '已付款', UNPAID: '未付款', SHIPPED: '已发货' })[value] || value; }",
            "styler": "function(value){ if (value === 'PAID') return { backgroundColor: '#E2EFDA', color: '#375623', bold: true }; if (value === 'UNPAID') return { backgroundColor: '#FDE9E9', color: '#C00000', bold: true }; return { backgroundColor: '#DEEBF7', color: '#1F3864' }; }"
          }
        ],
        "rows": [],
        "gridColor": "#333333", "gridWidthMm": 0.15,
        "showBorder": true, "showHeader": true,
        "headerFillColor": "#EEEEEE", "headerBold": true,
        "stripeColor": "#FAFAFA",
        "fontSizePt": 9, "fontFamily": "Microsoft YaHei",
        "rowHeightMm": 7, "cellPaddingMm": 1, "lineSpacing": 1.2,
        "conditionalStyles": [
          { "field": "name", "operator": "Contains", "value": "茶", "backgroundColor": "#FFF6D9" }
        ]
      }
    },
    {
      "id": "el-note", "type": "text", "xMm": 14, "yMm": 170, "widthMm": 182, "heightMm": 16, "zIndex": 4,
      "text": {
        "content": "温馨提示：签收前请当面核对商品数量与外观；如有破损请拒收并联系客服。扫码可查询物流轨迹。",
        "fontFamily": "Microsoft YaHei", "fontSizePt": 9,
        "color": "#444444", "horizontalAlign": "Left", "verticalAlign": "Top", "wrap": true, "lineSpacing": 1.2
      },
      "styler": "function(){ return { color: '#444444', fontSizePt: 9, lineSpacing: 1.6, letterSpacingPt: 0.4 }; }"
    },
    {
      "id": "el-footrule", "type": "line", "xMm": 14, "yMm": 196, "widthMm": 182, "heightMm": 0, "zIndex": 4,
      "line": { "strokeColor": "#8899AA", "strokeWidthMm": 0.2, "direction": "Horizontal", "dashPatternMm": null }
    },
    {
      "id": "el-footer", "type": "text", "xMm": 14, "yMm": 200, "widthMm": 182, "heightMm": 8, "zIndex": 5,
      "text": {
        "content": "CrossPrint 样式脚本演示 · formatter 改内容 / styler 改样式 · 设计态所见即所得由 testData 驱动",
        "fontFamily": "Microsoft YaHei", "fontSizePt": 7,
        "color": "#999999", "horizontalAlign": "Right", "verticalAlign": "Middle", "wrap": false, "lineSpacing": 1.2
      }
    }
  ]
}
