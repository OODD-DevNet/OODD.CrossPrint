<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net461</TargetFrameworks>
    <RootNamespace>CrossPrint.Printing</RootNamespace>
    <AssemblyName>CrossPrint.Printing</AssemblyName>
    <!-- Skia → GDI 位图逐行搬移用指针（避免 PNG 编码等中间放大，内存纪律的一半） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>OODD.CrossPrint.Printing</PackageId>
    <Description>CrossPrint 打印目标抽象层：把渲染引擎的产物送出去的统一出口。v0.1 提供 PdfFilePrintTarget（PDF 落盘，FR-PRT-01）与 SystemPrintTarget（ShellExecute / lp 调起系统打印管线，FR-PRT-03）。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrossPrint.Engine\CrossPrint.Engine.csproj" />
    <ProjectReference Include="..\CrossPrint.Core\CrossPrint.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" />
    <!-- GDI 直打（GdiPrintTarget）：net8.0 走 System.Drawing.Common（Windows 专用，编译跨平台、运行时守卫）；
         net461 用 BCL 自带的 System.Drawing.Printing。 -->
    <PackageReference Include="System.Drawing.Common" Condition="'$(TargetFramework)' == 'net8.0'" />
    <!-- 系统打印目标的交付通道不可在 CI 上真发作业，测试注入替身需要 internal 接口。 -->
    <InternalsVisibleTo Include="CrossPrint.Printing.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
