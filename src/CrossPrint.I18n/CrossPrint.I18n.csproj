<Project Sdk="Microsoft.NET.Sdk">

  <!-- CrossPrint I18n 资源中心：把 UI 层所有面向用户的字符串统一放这里。
       所有宿主 Designer/Avalonia/Wpf/WinForms/WinUi/Eto/Uno/Maui 都引用本项目，
       通过 Localizer.T("key") 取当前语言的字符串。JSON 内嵌为 EmbeddedResource，
       宿主只需 set CultureInfo.CurrentUICulture = ... 即可切换。 -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 允许 net461 / netstandard2.0 宿主也引用（WinForms/WPF 宿主是 net461 目标） -->
    <TargetFrameworks>net8.0;netstandard2.0;net461</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <!-- 资源 JSON 内嵌进程序集；Localizer 用 Assembly.GetManifestResourceStream 读取 -->
    <EmbeddedResource Include="Strings.zh-CN.json" />
    <EmbeddedResource Include="Strings.en-US.json" />
    <!-- 产品 logo：About Dialog + 各宿主窗口图标共用这一份 -->
    <EmbeddedResource Include="Assets\oodd-crossprint-logo.png" />
  </ItemGroup>

</Project>
