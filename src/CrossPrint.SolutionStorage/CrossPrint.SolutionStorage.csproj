<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CrossPrint.SolutionStorage</RootNamespace>
    <AssemblyName>CrossPrint.SolutionStorage</AssemblyName>
    <Description>跨宿主共享的解决方案模板持久化：SQLite（FreeSql）存储 + UI 无关的会话封装。所有桌面宿主共用一份实现。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrossPrint.Core\CrossPrint.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FreeSql" />
    <PackageReference Include="FreeSql.Provider.Sqlite" />
  </ItemGroup>

</Project>
