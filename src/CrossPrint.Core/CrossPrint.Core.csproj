<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 核心层双目标框架：net8.0（主流）+ net461（国内仍有大量企业存量）。
         SkiaSharp 2.88.9 原生支持 net461；System.Text.Json 6.0.9 通过 netstandard2.0 间接支持 net461。 -->
    <TargetFrameworks>net8.0;net461</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CrossPrint.Core</RootNamespace>
    <AssemblyName>CrossPrint.Core</AssemblyName>
    <PackageId>CrossPrint.Core</PackageId>
    <Description>CrossPrint 模板模型、单位换算与 JSON 序列化（无 UI 依赖）。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- 列结构变更命令（CrossPrint.Designer 的 TableColumnCommand）需要 Clone 系列做整体快照。 -->
    <InternalsVisibleTo Include="CrossPrint.Designer" />
    <!-- 字体缓存的容量纪律测试要读 CacheCount / Capacity。 -->
    <InternalsVisibleTo Include="CrossPrint.Core.Tests" />
  </ItemGroup>

</Project>
