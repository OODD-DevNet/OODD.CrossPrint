<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net461</TargetFrameworks>
    <RootNamespace>CrossPrint.Designer</RootNamespace>
    <AssemblyName>CrossPrint.Designer</AssemblyName>
    <PackageId>OODD.CrossPrint.Designer</PackageId>
    <Description>CrossPrint 设计器内核：视口、命中测试、交互状态机、命令、属性描述符与叠加层绘制。不引用任何宿主 UI 框架。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrossPrint.Engine\CrossPrint.Engine.csproj" />
    <ProjectReference Include="..\CrossPrint.Core\CrossPrint.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <!-- 内置模板目录依赖的两份样例资产：作为内嵌资源随 Designer 程序集分发，所有宿主共享读取。 -->
  <ItemGroup>
    <EmbeddedResource Include="kitchen-sink.template.json" LogicalName="BuiltinTemplates.kitchen-sink.template.json" />
    <EmbeddedResource Include="complex-receipt.template.json" LogicalName="BuiltinTemplates.complex-receipt.template.json" />
  </ItemGroup>

</Project>
