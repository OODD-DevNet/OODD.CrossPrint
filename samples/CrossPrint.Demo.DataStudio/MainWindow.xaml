<Window x:Class="CrossPrint.Demo.DataStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CrossPrint.Demo.DataStudio"
        Title="CrossPrint 数据工作台 · 表格跨页验证" Width="1280" Height="820"
        WindowStartupLocation="CenterScreen" FontSize="12">
    <Window.Resources>
        <local:AmountToBrushConverter x:Key="AmountToBrush"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="CellLeft" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellRight" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#F4F4F4" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="模板：" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="TemplateCombo" Width="300" VerticalContentAlignment="Center"/>
                <Button x:Name="PrintButton" Content="打印 PDF（跨页）" Click="OnPrintPdf"
                        Margin="14,0,6,0" Padding="14,4" FontWeight="Bold"/>
                <Button Content="打开输出目录" Click="OnOpenOutDir" Style="{StaticResource ToolButton}"/>
                <Button Content="保存 JSON" Click="OnExportJson" Margin="10,0,6,0" Style="{StaticResource ToolButton}"/>
                <Button Content="读取 JSON" Click="OnImportJson" Style="{StaticResource ToolButton}"/>
                <CheckBox x:Name="AutoCalcCheck" Content="自动算金额（数量×单价）" IsChecked="True"
                          Margin="10,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 底部：状态条 + 渲染告警 -->
        <StackPanel DockPanel.Dock="Bottom">
            <Border Background="#EEF5FF" BorderBrush="#D0E0F5" BorderThickness="0,1,0,0" Padding="10,5">
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </Border>
            <GroupBox Header="渲染告警" Padding="4">
                <ListBox x:Name="IssuesList" Height="100" FontFamily="Consolas" FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </GroupBox>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="335"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：表头数据，全部可编辑 -->
            <GroupBox Grid.Column="0" Header="表头数据（可直接编辑）" Margin="8,8,4,8" Padding="8,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="发票号码" Style="{StaticResource FieldLabel}" Width="76"/>
                            <TextBox Text="{Binding InvoiceNo}" Style="{StaticResource FieldBox}"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="出账日期" Style="{StaticResource FieldLabel}" Width="76"/>
                            <TextBox Text="{Binding InvoiceDate}" Style="{StaticResource FieldBox}"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="全单合计" Style="{StaticResource FieldLabel}" Width="76"/>
                            <TextBox Text="{Binding TotalAmount}" Style="{StaticResource FieldBox}"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="大写金额" Style="{StaticResource FieldLabel}" Width="76"/>
                            <TextBox Text="{Binding AmountInWords}" Style="{StaticResource FieldBox}"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="收款人" Style="{StaticResource FieldLabel}" Width="76"/>
                            <TextBox Text="{Binding Payee}" Style="{StaticResource FieldBox}"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="复核人" Style="{StaticResource FieldLabel}" Width="76"/>
                            <TextBox Text="{Binding Checker}" Style="{StaticResource FieldBox}"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="开票人" Style="{StaticResource FieldLabel}" Width="76"/>
                            <TextBox Text="{Binding Clerk}" Style="{StaticResource FieldBox}"/>
                        </DockPanel>

                        <Expander Header="购买方" IsExpanded="True" Margin="0,8,0,0">
                            <StackPanel Margin="8,4,0,0">
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Width="76"/>
                                    <TextBox Text="{Binding Buyer.Name}" Style="{StaticResource FieldBox}"/>
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="识别号" Style="{StaticResource FieldLabel}" Width="76"/>
                                    <TextBox Text="{Binding Buyer.TaxId}" Style="{StaticResource FieldBox}"/>
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="地址电话" Style="{StaticResource FieldLabel}" Width="76"/>
                                    <TextBox Text="{Binding Buyer.Address}" Style="{StaticResource FieldBox}"/>
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="开户行" Style="{StaticResource FieldLabel}" Width="76"/>
                                    <TextBox Text="{Binding Buyer.Bank}" Style="{StaticResource FieldBox}"/>
                                </DockPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="销售方" IsExpanded="False" Margin="0,6,0,0">
                            <StackPanel Margin="8,4,0,0">
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Width="76"/>
                                    <TextBox Text="{Binding Seller.Name}" Style="{StaticResource FieldBox}"/>
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="识别号" Style="{StaticResource FieldLabel}" Width="76"/>
                                    <TextBox Text="{Binding Seller.TaxId}" Style="{StaticResource FieldBox}"/>
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="地址电话" Style="{StaticResource FieldLabel}" Width="76"/>
                                    <TextBox Text="{Binding Seller.Address}" Style="{StaticResource FieldBox}"/>
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="开户行" Style="{StaticResource FieldLabel}" Width="76"/>
                                    <TextBox Text="{Binding Seller.Bank}" Style="{StaticResource FieldBox}"/>
                                </DockPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- 右：明细表格，增删改 + 批量加行 -->
            <DockPanel Grid.Column="1" Margin="4,8,8,8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="加一行" Click="OnAddRow" Style="{StaticResource ToolButton}"/>
                    <Button Content="删除选中" Click="OnDeleteSelected" Style="{StaticResource ToolButton}"/>
                    <Button Content="批量加" Click="OnAddBatch" Margin="14,0,0,0" Style="{StaticResource ToolButton}"/>
                    <TextBox x:Name="BatchCountBox" Text="100" Width="64" VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="行（随机商品，金额 8~192 覆盖三档行色）" Style="{StaticResource FieldLabel}"/>
                </StackPanel>
                <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E5E5"
                          RowHeight="25" CellEditEnding="OnCellEditEnding">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{Binding Amount, Converter={StaticResource AmountToBrush}}"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2.2*"
                                            ElementStyle="{StaticResource CellLeft}"/>
                        <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="1.1*"
                                            ElementStyle="{StaticResource CellLeft}"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding Qty}" Width="64"
                                            ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice}" Width="86"
                                            ElementStyle="{StaticResource CellRight}"/>
                        <DataGridTextColumn Header="金额" Binding="{Binding Amount}" Width="96"
                                            ElementStyle="{StaticResource CellRight}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
