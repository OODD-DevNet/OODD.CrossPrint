<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>CrossPrint.Printing.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <!-- 打印作业真的要走完栅格化 + PDF 写盘，缺原生库会在首次 SKCanvas 构造时抛 DllNotFoundException -->
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Condition="'$(OS)' == 'Unix' And $([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Condition="'$(OS)' == 'Unix' And !$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CrossPrint.Printing\CrossPrint.Printing.csproj" />
    <ProjectReference Include="..\..\src\CrossPrint.Engine\CrossPrint.Engine.csproj" />
    <ProjectReference Include="..\..\src\CrossPrint.Core\CrossPrint.Core.csproj" />
  </ItemGroup>

</Project>
