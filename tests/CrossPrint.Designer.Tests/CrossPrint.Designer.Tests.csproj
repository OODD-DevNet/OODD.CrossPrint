<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>CrossPrint.Designer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <!-- 叠加层断言要真的栅格化，缺原生库会在首次 SKCanvas 构造时抛 DllNotFoundException -->
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Condition="'$(OS)' == 'Unix' And $([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Condition="'$(OS)' == 'Unix' And !$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CrossPrint.Designer\CrossPrint.Designer.csproj" />
    <ProjectReference Include="..\..\src\CrossPrint.Engine\CrossPrint.Engine.csproj" />
    <ProjectReference Include="..\..\src\CrossPrint.Core\CrossPrint.Core.csproj" />
  </ItemGroup>

</Project>
