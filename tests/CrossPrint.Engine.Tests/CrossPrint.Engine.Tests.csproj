<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>CrossPrint.Engine.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <!-- 渲染断言必须真的栅格化，缺原生库会在首次 SKCanvas 构造时抛 DllNotFoundException -->
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Condition="'$(OS)' == 'Unix' And $([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Condition="'$(OS)' == 'Unix' And !$([MSBuild]::IsOSPlatform('OSX'))" />
    <!-- HarfBuzzSharp 的托管包只把 Win32/macOS 原生库写成自己的依赖（实测 project.assets.json 就这两条），
         Linux 上的 libHarfBuzzSharp.so 必须消费方点名引用；缺它时 Shape 静默返回 null、复杂脚本退回 cmap 直译。
         本机实证：把 win-x64/native/libHarfBuzzSharp.dll 移走，ComplexScriptRenderingTests 八条里炸六条。
         CI 的 ubuntu 那一条腿没有这行，复杂脚本断言就会全红。 -->
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Condition="'$(OS)' == 'Unix' And !$([MSBuild]::IsOSPlatform('OSX'))" />
    <!-- 反解渲染结果，证明二维码/条码真的可被扫描枪读出 -->
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CrossPrint.Engine\CrossPrint.Engine.csproj" />
    <ProjectReference Include="..\..\src\CrossPrint.Core\CrossPrint.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复杂脚本 shaping 的判定必须有确定字体：系统里的阿拉伯字体随机器变（Windows 是 Segoe UI，
         CI 的 ubuntu 可能是 DejaVu——后者根本没有阿拉伯文 GSUB），内嵌一份 OFL 字体才能把
         "连字/词形式替换真的发生了"钉成跨平台可复现的断言。字体不入库进产品，只在测试程序集里。 -->
    <EmbeddedResource Include="Assets\NotoNaskhArabic-VF.ttf" />
    <EmbeddedResource Include="Assets\OFL-NotoNaskhArabic.txt" />
  </ItemGroup>

</Project>
