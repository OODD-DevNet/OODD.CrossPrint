<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS1591;CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</WarningsAsErrors>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <!-- net461 / netstandard2.0 上 PolySharp 虽然 polyfill 了 IsExternalInit / Range / Index 等，
         但 nullable reference types 的语义（CS86xx）编译器不完整实现。
         源生成器（STJ / PolySharp）在 net461 上还会触发 CS8336（EmbeddedAttribute 冲突）。
         这些在 net8.0 上是干净的，只对旧 TFM 放开。 -->
    <NoWarn Condition="'$(TargetFramework)' == 'net461' Or '$(TargetFramework)' == 'netstandard2.0'">$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8625;CS8336;CS0165;CS1591</NoWarn>
    <!-- PolySharp 在 net461 上生成 EmbeddedAttribute 与 Roslyn 编译器冲突（CS8336）。 -->
    <PolySharpUseEmbeddedAttributeForGeneratedTypes Condition="'$(TargetFramework)' == 'net461' Or '$(TargetFramework)' == 'netstandard2.0'">false</PolySharpUseEmbeddedAttributeForGeneratedTypes>
  </PropertyGroup>

  <!-- Library packages: full docs + package metadata -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true' And '$(IsSampleProject)' != 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>OODD CrossPrint Contributors</Authors>
    <Product>CrossPrint</Product>
    <Copyright>Copyright (c) 2026 OODD</Copyright>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>1.0.0</VersionPrefix>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- netstandard2.0 / net461 不支持 PublishTrimmed / PublishAot。
       I18n 项目多目标框架时，Avalonia sample 做 partial trim publish 会 restore 所有 TFM，
       必须在这里全局禁用——否则 NETSDK1124 报错。
       注意：这只禁用 trim/AOT，正常 build/publish/运行不受影响。 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net461'">
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <IsTrimmable>false</IsTrimmable>
    <EnableAotAnalyzers>false</EnableAotAnalyzers>
  </PropertyGroup>

  <!-- 包内附仓库 README（NuGet.org 详情页来源）；样例/测试不打包 -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true' And '$(IsSampleProject)' != 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsSampleProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
