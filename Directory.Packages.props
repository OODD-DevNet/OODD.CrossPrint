<Project>
  <!--
    全仓依赖版本唯一真源。禁止在 csproj 内写 Version=。
    SkiaSharp 锁 2.88.9：Views.* 系列在 3.x/4.x 的 TFM 支持面分裂（见 docs/02-architecture.md A2），
    混装会导致原生库版本冲突。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- 渲染核心 -->
    <PackageVersion Include="SkiaSharp" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="2.88.9" />
    <!-- 编码：ZXing 零传递依赖，纯 BitMatrix 输出。
         不用 QRCoder——实测 1.8.1 传递引入 System.Drawing.Common（Linux 上不可用），
         QRCoder.Core 2.0.0 又强制 SkiaSharp 3.119（与本仓 2.88.9 锁冲突）。见 docs/02 A4b。 -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <!-- JSON：6.0.9 有 netstandard2.0 目标（间接支持 net461）；8.x 最低 net8.0。 -->
    <PackageVersion Include="System.Text.Json" Version="6.0.9" />
    <PackageVersion Include="System.Drawing.Common" Version="8.0.0" />
    <!-- 脚本：纯托管 JS 解释器（formatter/styler），默认无 CLR 访问，沙箱安全 -->
    <PackageVersion Include="Jint" Version="3.1.6" />
    <!-- 宿主 -->
    <PackageVersion Include="Avalonia" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Browser" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Skia" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <!-- 无头渲染测试：真正跑 Skia 合成器后抓帧，用来量窗口里有没有漏画的透明像素。 -->
    <PackageVersion Include="Avalonia.Headless" Version="11.3.18" />
    <!-- Desktop 宿主主题：Semi Design 风格（圆角按钮、阴影输入框、Ant Design 蓝主色调）。
         Semi.Avalonia 是主题不是控件库——原生 Button/TextBox/ComboBox/DataGrid 自动套用，
         不需要把 Tag 换成 semi:Button。Browser/WASM 保持 FluentTheme（条件编译隔离）。 -->
    <PackageVersion Include="Semi.Avalonia" Version="11.3.14" />
    <!-- Semi 的取色面板主题：为 Avalonia.Controls.ColorPicker 控件套 Semi 风格（依赖会自动带入基础控件包）。
         与 Semi.Avalonia 保持同版本号（11.3.14 成对发布）。 -->
    <PackageVersion Include="Semi.Avalonia.ColorPicker" Version="11.3.14" />
    <!-- ColorPicker 控件本体（Avalonia 11.1 起拆出主包）：浏览器工程直接引用，桌面工程经 Semi 包带入 -->
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="11.3.14" />
    <!-- 宿主主题库，核心层不引用 -->
    <!-- WPF 宿主主题：HandyControl（圆角按钮、阴影、Material Design 风格），原生控件自动套用 -->
    <PackageVersion Include="HandyControl" Version="3.5.1" />
    <!-- net461 多目标框架需要 polyfill C# 9+ 运行时特性（IsExternalInit / 默认接口实现）。
         PolySharp 是 source-only polyfill——不影响 net8.0，只对 netstandard2.0/net461 生效。 -->
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <!-- HarfBuzz：复杂脚本 OpenType shaping（阿拉伯文连字/天城文重排/藏文元音附着）。
         有 netstandard2.0 目标 → 间接支持 net461。只在 ScriptClassifier 检测到复杂脚本时才走这条路径，
         西文/CJK 全程走 Skia 快路径，零额外开销。 -->
    <PackageVersion Include="HarfBuzzSharp" Version="14.2.1.301" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.2.1.301" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.301" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.macOS" Version="14.2.1.301" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="2.88.9" />
    <PackageVersion Include="Eto.Forms" Version="2.10.0" />
    <PackageVersion Include="Eto.Platform.Windows" Version="2.10.0" />
    <PackageVersion Include="SkiaSharp.Views.Desktop.Common" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.Views.WPF" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.Views.WinUI" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.Views.Uno.WinUI" Version="2.88.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <!-- 测试 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <!-- 解决方案持久化（仅桌面样例）：FreeSql + SQLite 存模板记录。浏览器端走 localStorage，不引这两个包。
         3.2.699 还原不到（NuGet 近似解析到 3.2.700 并报 NU1603），直接钉实际可用的 3.2.700。 -->
    <PackageVersion Include="FreeSql" Version="3.2.700" />
    <PackageVersion Include="FreeSql.Provider.Sqlite" Version="3.2.700" />
  </ItemGroup>
</Project>